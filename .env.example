# ==========================================
# Synctis Configuration
# ==========================================

# ------------------------------------------
# WebUntis Credentials (Required)
# ------------------------------------------
# The WebUntis server domain used by your school (e.g., archetype.webuntis.com)
UNTIS_SERVER=archetype.webuntis.com
UNTIS_USERNAME=your_untis_username
UNTIS_PASSWORD=your_untis_password
UNTIS_SCHOOL=your_school_login_name
# Optional: Appended or formatted in the Location field of Google Calendar events
UNTIS_SCHOOL_LOCATION=

# ------------------------------------------
# Google Calendar & OAuth2 (Required)
# ------------------------------------------
# Google Cloud OAuth 2.0 Client ID and Secret (Web application or Desktop application)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Target Google Calendar ID (can be primary or an ID from calendar settings)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Optional: Google Calendar styling / event type (DEFAULT, FOCUSTIME, OUTOFOFFICE, WORKINGLOCATION)
GOOGLE_DEFAULT_EVENT_TYPE=FOCUSTIME
GOOGLE_DEFAULT_COLOR_ID=

# Token storage file (in Docker/compose, persisted via volume to /data/.google-auth)
GOOGLE_AUTH_FILE=/data/.google-auth

# ------------------------------------------
# Server & OAuth Callback Configuration
# ------------------------------------------
# Port used for the Google OAuth authorization flow server
PORT=8080
# Host used by your browser for OAuth redirect (usually localhost or your domain/IP)
HOST=localhost
# Host address Ktor binds to (0.0.0.0 inside container, localhost when running bare metal)
HOST_KTOR=0.0.0.0

# ------------------------------------------
# Synchronization Schedule & Options
# ------------------------------------------
# Cron schedule for synchronization (default: every day at 05:00)
# See https://crontab.guru to customize
RUN_SCHEDULE="0 5 1-31 * *"

# Number of weeks into the future to synchronize timetable events (min: 1, default: 2)
WEEKS_IN_FUTURE=2

# Enable debug logging (true/false)
DEBUG=false
